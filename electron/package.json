{
  "name": "musicyc",
  "version": "1.0.4",
  "description": "A free music streaming and downloading app",
  "main": "main.js",
  "type": "module",
  "homepage": "https://github.com/Cyclonekillzyt/Musicyc-electron.git",
  "author": {
    "name": "Cyclone Kendricks",
    "email": "kendrickscyclone@gmail.com"
  },
  "scripts": {
    "start": "electron .",
    "build": "electron-builder"
  },
  "build": {
    "appId": "com.example.musicyc",
    "productName": "Musicyc",
    "directories": {
      "buildResources": "assets",
      "output": "dist_electron"
    },
    "files": [
      "main.js",
      "preload.js",
      "package.json",
      "context.js",
      "server.js",
      "download.js",
      "stream.js",
      "search.js",
      "logic/**/*",
      ".env"
    ],
    "extraResources": [
      {
        "from": "bin",
        "to": "bin"
      },
      {
        "from": "../Frontend/dist",
        "to": "frontend/dist"
      }
    ],
    "mac": {
      "target": [
        "dmg",
        "zip"
      ]
    },
    "win": {
      "target": [
        "nsis",
        "zip"
      ]
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ]
    }
  },
  "devDependencies": {
    "electron": "^44.0.0",
    "electron-builder": "^26.15.3"
  },
  "dependencies": {
    "dotenv": "^17.4.2",
    "googleapis": "^176.0.0"
  }
}
